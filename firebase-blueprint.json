{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Publicly visible artist and curator profile without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000
        },
        "bio": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "photoURL", "bio", "createdAt", "updatedAt"]
    },
    "UserPrivateAccount": {
      "title": "UserPrivateAccount",
      "description": "Private user account data containing email PII and notification preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "pushEnabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "pushEnabled", "createdAt", "updatedAt"]
    },
    "Album": {
      "title": "Album",
      "description": "Curated gallery album containing digital artworks with granular sharing controls.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "coverUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "ownerPhotoUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "unlisted", "private", "invite"]
        },
        "artCount": {
          "type": "integer"
        },
        "artworkIds": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "coverUrl",
        "ownerId",
        "ownerName",
        "ownerPhotoUrl",
        "visibility",
        "artCount",
        "artworkIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "AlbumInvite": {
      "title": "AlbumInvite",
      "description": "Invite-only permission grant linking an email address to a private or invite album.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 5,
          "maxLength": 384
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "albumId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "albumTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "coverUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["viewer", "editor"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "email",
        "albumId",
        "albumTitle",
        "coverUrl",
        "ownerId",
        "ownerName",
        "role",
        "createdAt",
        "updatedAt"
      ]
    },
    "Artwork": {
      "title": "Artwork",
      "description": "Digital artwork piece stored in an album with high-resolution media reference.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "albumId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "ownerPhotoUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "medium": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "dimensions": {
          "type": "string",
          "maxLength": 60
        },
        "year": {
          "type": "string",
          "maxLength": 12
        },
        "tags": {
          "type": "array"
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "aspectRatio": {
          "type": "string",
          "enum": ["4:3", "3:4", "16:9", "1:1", "auto"]
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "unlisted", "private", "invite"]
        },
        "likesCount": {
          "type": "integer"
        },
        "commentsCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "albumId",
        "ownerId",
        "ownerName",
        "ownerPhotoUrl",
        "title",
        "description",
        "medium",
        "dimensions",
        "year",
        "tags",
        "imageUrl",
        "aspectRatio",
        "visibility",
        "likesCount",
        "commentsCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "ArtworkLike": {
      "title": "ArtworkLike",
      "description": "User appreciation record for an artwork.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "userName", "createdAt"]
    },
    "ArtworkComment": {
      "title": "ArtworkComment",
      "description": "Real-time critique or comment on an artwork.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "artworkId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "authorPhotoUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "unlisted", "private", "invite"]
        },
        "artworkOwnerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "artworkId",
        "authorId",
        "authorName",
        "authorPhotoUrl",
        "text",
        "visibility",
        "artworkOwnerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "Notification": {
      "title": "Notification",
      "description": "Real-time notification for artwork likes or comments.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "actorPhotoUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "type": {
          "type": "string",
          "enum": ["like", "comment", "invite"]
        },
        "artworkId": {
          "type": "string",
          "maxLength": 128
        },
        "artworkTitle": {
          "type": "string",
          "maxLength": 160
        },
        "albumId": {
          "type": "string",
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "recipientId",
        "actorId",
        "actorName",
        "actorPhotoUrl",
        "type",
        "artworkId",
        "artworkTitle",
        "albumId",
        "message",
        "read",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public artist and curator profile records (no PII)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateAccount" },
      "description": "Private user account info containing verified email PII and push settings."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Real-time notifications for likes, comments, and album invitations."
    },
    "/albums/{albumId}": {
      "schema": { "$ref": "#/entities/Album" },
      "description": "Curated digital art albums with public, unlisted, private, or invite visibility."
    },
    "/invites/{inviteKey}": {
      "schema": { "$ref": "#/entities/AlbumInvite" },
      "description": "Email-based invite permissions keyed by albumId__email."
    },
    "/artworks/{artworkId}": {
      "schema": { "$ref": "#/entities/Artwork" },
      "description": "Individual artwork records linked to an album."
    },
    "/artworks/{artworkId}/likes/{userId}": {
      "schema": { "$ref": "#/entities/ArtworkLike" },
      "description": "Per-user likes on an artwork."
    },
    "/artworks/{artworkId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/ArtworkComment" },
      "description": "Real-time comments on an artwork."
    }
  }
}
